// Crates -- deployed by .github/workflows/deploy.yml when main moves.
// Nothing is served until the four vars below are filled in: the Worker
// answers 503 to every request until it can verify Cloudflare Access tokens.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinyl-crates",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-25",
  // Only the custom domain, which Cloudflare Access guards. A workers.dev or
  // preview URL would be an unguarded second door.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "crates.bobshrimp.com", "zone_name": "bobshrimp.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request, page included, goes through the token check first.
    "run_worker_first": true
  },
  // Phase 3's gigs, members and requests. Created 2026-10-01 (Eastern North America). The
  // Worker creates and migrates its own tables (src/schema.ts), so a deploy needs no D1
  // permission on the token: with the id given, deploying only binds it.
  "d1_databases": [{ "binding": "DB", "database_name": "vinyl-crates", "database_id": "3f6815c4-12c4-40ed-8459-406407af2408" }],
  "r2_buckets": [{ "binding": "CATALOG", "bucket_name": "vinyl-crates-catalog" }],
  "observability": { "enabled": true },
  "vars": {
    // vinyl-command tools/crates_access.py setup prints all four.
    "TEAM_DOMAIN": "bobshrimp.cloudflareaccess.com",
    "ACCESS_AUD_SITE": "449c5949d1a66c303d8c2810c1422339406da3e30b1e87b3408d209525e67981",
    "ACCESS_AUD_ADMIN": "54c803238fef2e566b2b73336626e2a91acf2454e9db9b1aec4e2a10e7650cfb",
    "PUBLISHER_CLIENT_ID": "470dfdafd1886e519aff4b7e96dd2e71.access",
    // The DJ: sees every list, owns /dj. Also allowed in by the "Crates visitors" policy.
    "OWNER_EMAIL": "dschifman@gmail.com"
  }
}
