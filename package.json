{
  "name": "vinyl-crates",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  }
}
